	(text "RP2040 PROGRAMMER"
		(exclude_from_sim no)
		(at 232.156 174.752 0)
		(effects
			(font
				(size 2.54 2.54)
				(italic yes)
			)
		)
		(uuid "28e50a36-5554-4953-bfca-30e2c531c856")
	)
	(text "The Raspberry Pi RP2040 serves as programmer for the devices in the board.\nThe STM32 MCU is programmed through the SWD protocol.\nThe FPGA is programmed through the JTAG protocol.\nThe RP2040 here, acts as a bridge between these protocols and USB.\nThis means that both the MCU and the FPGA can be programmed directly through the USB-C provided.\n\nThe circuitry for the RP2040 was derived from the official \"Hardware design with RP2040\" guidelines"
		(exclude_from_sim no)
		(at 17.526 180.594 0)
		(effects
			(font
				(size 1.905 1.905)
			)
			(justify left)
			(href "https://pip-assets.raspberrypi.com/categories/814-rp2040/documents/RP-008279-DS-1-hardware-design-with-rp2040.pdf")
		)
		(uuid "3c697e97-e653-4691-82b6-e8591ad860ad")
	)
	(text "Resistor R3 is a Do-Not-Fit part\nR6 and R7 must be placed close to the MCU\nC14 must be placed close to pin 44\nC17 must be placed close to pin 45\n"
		(exclude_from_sim no)
		(at 227.584 27.432 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left)
		)
		(uuid "88cbe9bf-1f15-44cc-89ca-dc354f48beb1")
	)
	(text "OSCILLATOR"
		(exclude_from_sim no)
		(at 48.006 155.702 0)
		(effects
